generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String?          @unique
  passwordHash    String?
  role            Role             @default(CUSTOMER)
  avatarUrl       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  mobile          String?          @unique
  walletBalance   Float            @default(0)
  addresses       Address[]
  cartItems       CartItem[]
  notifications   Notification[]
  orders          Order[]
  sessions        Session[]
  supportMessages SupportMessage[]
  supportTickets  SupportTicket[]
  wishlistItems   WishlistItem[]
  reviews         Review[]
}

model OtpVerification {
  id          String   @id @default(uuid())
  mobile      String   @unique
  hashedOtp   String
  attempts    Int      @default(0)
  resendCount Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  title         String
  recipientName String
  phone         String
  street        String
  city          String
  state         String
  postalCode    String
  country       String   @default("India")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id              String    @id @default(uuid())
  name            String    @unique
  slug            String    @unique
  description     String?
  image           String?
  seoTitle        String?
  seoDescription  String?
  isVisible       Boolean   @default(true)
  homepageVisible Boolean   @default(true)
  promoVisible    Boolean   @default(true)
  position        Int       @default(0)
  isFeatured      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[] @relation("CategoryToProduct")
}

model Product {
  id                  String           @id @default(uuid())
  name                String
  slug                String           @unique
  description         String
  shortDescription    String?
  brand               String?          @default("Suryodaya Farms")
  productType         String?
  price               Float
  compareAtPrice      Float?
  mrp                 Float?
  discountPercent     Float?           @default(0)
  taxPercent          Float?           @default(0)
  stockStatus         String?          @default("IN_STOCK")
  sku                 String           @unique
  inventory           Int              @default(0)
  hoverImage          String?
  mobileBanner        String?
  isFeatured          Boolean          @default(false)
  isTrending          Boolean          @default(false)
  isBestseller        Boolean          @default(false)
  isNewLaunch         Boolean          @default(false)
  isVisible           Boolean          @default(true)
  isComingSoon        Boolean          @default(false)
  nutrients           String?
  origin              String?
  shelfLife           String?
  deliveryEta         String?          @default("2-3 Days")
  codAvailable        Boolean          @default(true)
  returnEligible      Boolean          @default(false)
  weight              String?
  seoTitle            String?
  seoDescription      String?
  seoKeywords         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  images              String[]
  productContent      Json?
  detailedDescription String?
  cartItems           CartItem[]
  orderItems          OrderItem[]
  contentSections     ProductContent[]
  productImages       ProductImage[]
  variants            ProductVariant[]
  wishlistItems       WishlistItem[]
  reviews             Review[]
  categories          Category[]       @relation("CategoryToProduct")
}

model ProductContent {
  id          String   @id @default(uuid())
  productId   String
  sectionType String
  title       String?
  content     Json
  orderIndex  Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id         String  @id @default(uuid())
  productId  String
  url        String
  isFeatured Boolean @default(false)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id         String      @id @default(uuid())
  productId  String
  name       String
  price      Float
  mrp        Float?
  sku        String?
  inventory  Int         @default(0)
  unit       String?
  weight     String?
  cartItems  CartItem[]
  orderItems OrderItem[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CartItem {
  id        String          @id @default(uuid())
  userId    String
  productId String
  variantId String?
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id])
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Float
  minOrderValue Float        @default(0)
  expiryDate    DateTime
  usageLimit    Int?         @default(-1)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  orders        Order[]
}

model Order {
  id                 String          @id @default(uuid())
  userId             String
  orderNumber        String          @unique
  status             OrderStatus     @default(PENDING)
  paymentStatus      PaymentStatus   @default(PENDING)
  paymentMethod      PaymentMethod   @default(COD)
  razorpayOrderId    String?
  razorpayPaymentId  String?
  totalAmount        Float
  discountAmount     Float           @default(0)
  couponId           String?
  shippingAddress    Json
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  awbCode            String?
  courierId          Int?
  courierName        String?
  invoiceUrl         String?
  labelUrl           String?
  manifestUrl        String?
  pickupId           String?
  shipmentId         Int?
  shiprocketData     Json?
  shiprocketOrderId  Int?
  shiprocketStatus   String?
  trackingHistory    Json?
  refundAmount       Float?
  refundDate         DateTime?
  refundError        String?
  refundId           String?
  refundResponse     Json?
  refundStatus       String?
  lastRefundSync     DateTime?
  refundCompletedAt  DateTime?
  refundExpectedDate DateTime?
  refundGateway      String?         @default("Razorpay")
  refundInitiatedAt  DateTime?
  coupon             Coupon?         @relation(fields: [couponId], references: [id])
  user               User            @relation(fields: [userId], references: [id])
  orderItems         OrderItem[]
  supportTickets     SupportTicket[]
}

model ShippingSettings {
  id                    String   @id @default("default")
  defaultPickupLocation String   @default("Primary Warehouse")
  pickupPincode         String   @default("302001")
  autoAssignCourier     Boolean  @default(true)
  preferredCourierMode  String   @default("CHEAPEST")
  preferredCourierId    Int?
  freeShippingThreshold Float    @default(999)
  codEnabled            Boolean  @default(true)
  maxWeight             Float    @default(20)
  defaultLength         Float    @default(15)
  defaultWidth          Float    @default(15)
  defaultHeight         Float    @default(10)
  webhookUrl            String?
  updatedAt             DateTime @updatedAt
}

model OrderItem {
  id        String          @id @default(uuid())
  orderId   String
  productId String
  variantId String?
  quantity  Int
  price     Float
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
}

model Review {
  id           String   @id @default(uuid())
  userId       String   @map("customer_id")
  productId    String   @map("product_id")
  customerName String?  @map("customer_name")
  rating       Int      @default(5)
  reviewTitle  String?  @map("review_title")
  reviewText   String?  @map("review_text")
  reviewImages String[] @map("review_images")
  status       String   @default("PENDING")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_reviews")
}

model Blog {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String
  summary   String
  image     String
  category  String
  author    String
  readTime  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id               String   @id @default(uuid())
  customerName     String   @map("customer_name")
  location         String?  @map("location")
  testimonialText  String   @map("testimonial_text")
  rating           Int      @default(5)
  customerPhoto    String?  @map("customer_photo")
  productPurchased String?  @map("product_purchased")
  featuredToggle   Boolean  @default(false) @map("featured_toggle")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("testimonials")
}

model Gallery {
  id          String   @id @default(uuid())
  title       String
  category    String
  image       String
  description String
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id         String   @id @default(uuid())
  name       String
  email      String
  phone      String
  subject    String   @default("General Enquiry")
  category   String   @default("General Enquiry")
  type       String?  @default("General Enquiry")
  message    String
  attachment String?
  status     String   @default("NEW")
  adminNotes String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("contact_messages")
}

model SEOSetting {
  id          String @id @default(uuid())
  page        String @unique
  title       String
  description String
  keywords    String
}

model WebsiteSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model HomepageCampaign {
  id                  String    @id @default(uuid())
  title               String
  subtitle            String
  description         String
  heroImage           String
  featuredProductId   String?
  discountText        String?
  primaryButtonText   String    @default("Shop Now")
  primaryButtonLink   String    @default("/")
  secondaryButtonText String?   @default("Explore Collection")
  secondaryButtonLink String?   @default("/")
  badgeText           String?
  isActive            Boolean   @default(false)
  startDate           DateTime?
  endDate             DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model HomepageCollection {
  id           String   @id @default(uuid())
  title        String
  badge        String?
  description  String
  image        String
  ctaText      String   @default("Browse Collection") @map("cta_text")
  categorySlug String   @map("category_slug")
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("homepage_collections")
}

model HomepageHero {
  id                    String   @id @default(uuid())
  trustBadgeText        String?
  headingLine1          String?
  headingHighlight      String?
  headingLine2          String?
  description           String?
  bulletOne             String?
  bulletTwo             String?
  bulletThree           String?
  bulletFour            String?
  primaryButtonText     String?
  primaryButtonLink     String?
  secondaryButtonText   String?
  secondaryButtonLink   String?
  promoText             String?
  heroImage             String?
  cropX                 Float?
  cropY                 Float?
  cropWidth             Float?
  cropHeight            Float?
  zoom                  Float?
  aspectRatio           String?
  featuredProductId     String?
  offerBadgeText        String?
  floatingBadgeTitle    String?
  floatingBadgeSubtitle String?
  slideOrder            Int      @default(0)
  isFeatured            Boolean  @default(false)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model SupportTicket {
  id           String           @id @default(uuid())
  ticketNumber String           @unique
  userId       String
  orderId      String?
  subject      String
  status       TicketStatus     @default(OPEN)
  priority     TicketPriority   @default(MEDIUM)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  messages     SupportMessage[]
  order        Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportMessage {
  id        String        @id @default(uuid())
  ticketId  String
  senderId  String
  role      Role          @default(CUSTOMER)
  message   String
  imageUrl  String?
  createdAt DateTime      @default(now())
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  RAZORPAY
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model PartnerRequest {
  id                  String   @id @default(uuid())
  name                String
  companyName         String
  businessType        String
  gstNumber           String?
  email               String
  phone               String
  country             String
  state               String
  city                String
  website             String?
  partnershipType     String
  yearsInBusiness     String?
  monthlyRequirement  String?
  businessDescription String?
  message             String?
  status              String   @default("NEW")
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("partner_requests")
}

model SupportRequest {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String
  subject     String
  category    String
  message     String
  orderNumber String?
  attachment  String?
  status      String   @default("NEW")
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("support_requests")
}


